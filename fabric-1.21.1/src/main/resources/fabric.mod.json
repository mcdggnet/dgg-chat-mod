  "authors": ["mcdgg"],
  "contact": { "homepage": "https://mcdgg.net" },
  "license": "Proprietary",
  "environment": "*",
  "entrypoints": {
    "main": ["net.mcdgg.chat.fabric.DggChatFabric"],
    "client": ["net.mcdgg.chat.fabric.client.DggChatFabricClient"]
  },
  "mixins": ["dggchat.fabric.mixins.json"],
  "depends": {
    "fabricloader": ">=0.18.4",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  }
}
